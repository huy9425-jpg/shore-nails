# ============================================================================
# SHORE NAILS — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to `.env.local` for local development and add these variables
# in Vercel -> Project Settings -> Environment Variables for production.
# Never commit `.env` or `.env.local` to GitHub.
# ============================================================================

# Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (Safe for browser client & RLS-enforced queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Secret: Supabase Service Role Key (Never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-Only Secret: Comma-separated list of authorized administrator emails for /admin
# Non-admin authenticated users not in this list (and without app_metadata.role = 'admin') are rejected with 403.
ADMIN_ALLOWED_EMAILS=owner@example.com

